Keep transparent PDF thumbnails transparent during recoloring and resizing.

The thumbnail is displayed while a replacement page render is pending. Its
surface must retain alpha, and drawing it must preserve the viewer background
under transparent pixels, just as the full-size page drawing path does.

--- a/zathura/page-widget.c
+++ b/zathura/page-widget.c
@@ -573,7 +573,7 @@
         /* pixman bilinear downscaling is slow */
         cairo_pattern_set_filter(cairo_get_source(cairo), CAIRO_FILTER_FAST);
       }
-      cairo_set_operator(cairo, CAIRO_OPERATOR_SOURCE);
+      cairo_set_operator(cairo, CAIRO_OPERATOR_OVER);
       cairo_paint(cairo);
       cairo_restore(cairo);
       /* All but the last jobs requested here are aborted during zooming.
@@ -801,6 +801,6 @@
   /* create thumbnail surface, taking width and height as _unscaled_ device units */
   cairo_surface_t* thumbnail =
-      cairo_surface_create_similar(surface, CAIRO_CONTENT_COLOR, unscaled_width, unscaled_height);
+      cairo_surface_create_similar(surface, CAIRO_CONTENT_COLOR_ALPHA, unscaled_width, unscaled_height);
   if (cairo_surface_status(thumbnail) != CAIRO_STATUS_SUCCESS) {
     return NULL;
   }
